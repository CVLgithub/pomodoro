{
  "expo": {
    "name": "Pomodoro",
    "slug": "pomodoro-local-first",
    "scheme": "pomodoro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.constantin.pomodoro"
    },
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07d63ace-8f18-4a56-bce8-2995f8fe3bda"
      }
    },
    "android": {
      "package": "com.constantin.pomodoro"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/07d63ace-8f18-4a56-bce8-2995f8fe3bda"
    }
  }
}
